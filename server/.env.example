NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=replace-with-64-hex-characters
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
# Read-only activity access: issues, pull requests, commits, deployments.
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
PROVIDER_SYNC_INTERVAL_MS=900000